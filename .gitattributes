# Texto com fim de linha normalizado; scripts do Windows sempre com CRLF
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários (modelos, fontes, imagens)
*.onnx binary
*.sdict binary
*.pt binary
*.ckpt binary
*.woff2 binary
*.ico binary
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.m4a binary
